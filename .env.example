# ===========================================================================
# Provider selection. These two variables are the only thing that has to change
# to swap an entire infrastructure backend: no domain or graph code is touched.
# ===========================================================================
# azure | aws | google | native_vlm
EXTRACTOR_PROVIDER=native_vlm
# openai | anthropic | ollama
VLM_PROVIDER=openai

# ===========================================================================
# Workflow behaviour
# ===========================================================================
MAX_RETRIES=3
LOG_LEVEL=INFO

# ===========================================================================
# Preprocessing (Node 0)
# ===========================================================================
# Laplacian variance below BLUR_CRITICAL_THRESHOLD triggers an unsharp mask;
# below half of it the document is rejected before any API call.
BLUR_CRITICAL_THRESHOLD=120.0
BLUR_REFERENCE_WIDTH=1000
UNSHARP_AMOUNT=0.8
UNSHARP_SIGMA=2.0
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_GRID_SIZE=8
MAX_IMAGE_DIMENSION=2000
JPEG_QUALITY=85
ORIGINAL_JPEG_QUALITY=95
ROI_PADDING_RATIO=0.10
ROI_MIN_WIDTH=320
ROI_MAX_UPSCALE=4.0

# ===========================================================================
# Azure AI Document Intelligence
# ===========================================================================
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Optional override of the document type to model mapping (JSON).
AZURE_MODEL_BY_DOC_TYPE={"ine": "prebuilt-idDocument", "invoice": "prebuilt-invoice"}

# ===========================================================================
# AWS Textract
# ===========================================================================
AWS_REGION=us-east-1
# Leave the keys empty to use the default boto3 credential chain (IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ===========================================================================
# Google Document AI
# ===========================================================================
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us
GOOGLE_PROCESSOR_BY_DOC_TYPE={"ine": "<identity-processor-id>", "invoice": "<invoice-processor-id>"}
GOOGLE_DEFAULT_PROCESSOR_ID=
GOOGLE_PROCESSOR_VERSION=
# Path to a service account JSON file; omit to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# ===========================================================================
# OpenAI
# ===========================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=

# ===========================================================================
# Anthropic
# ===========================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=

# ===========================================================================
# Ollama (local Qwen2.5-VL)
# ===========================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_KEEP_ALIVE=5m

# ===========================================================================
# Shared VLM tuning
# ===========================================================================
VLM_MAX_TOKENS=1024
VLM_TEMPERATURE=0.0
VLM_TIMEOUT_SECONDS=60.0

# ===========================================================================
# Native VLM extractor
# ===========================================================================
# Ask the VLM to also return normalized bounding boxes. Without geometry the
# ROI retry falls back to re-reading the whole page.
NATIVE_VLM_REQUEST_BOUNDING_BOXES=false
NATIVE_VLM_LAYOUT_HINTS={"ine": "The photo is on the left; CURP and the elector key are printed on the right block."}
