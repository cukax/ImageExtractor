# ===========================================================================
# Provider selection. These two variables are the only thing that has to change
# to swap an entire infrastructure backend: no domain or graph code is touched.
# ===========================================================================
# azure | aws | google | native_vlm
EXTRACTOR_PROVIDER=native_vlm
# openai | anthropic | ollama | azure_foundry
VLM_PROVIDER=openai
# pymupdf
PDF_PROCESSOR=pymupdf

# ===========================================================================
# Workflow behaviour
# ===========================================================================
MAX_RETRIES=3
LOG_LEVEL=INFO

# ===========================================================================
# Dossier engine (multi-document PDF, headless Map-Reduce)
# ===========================================================================
# 300 DPI is the floor at which small print on an identity card survives
# rasterization.
PDF_RENDER_DPI=300
# Classification is a layout question, so the classifier sees a shrunk copy.
CLASSIFICATION_MAX_DIMENSION=768
# Overrides of the worker routing table, merged onto the defaults (JSON).
# Identity documents take the template based branch, everything else the
# visual grounding one.
STRATEGY_BY_DOC_TYPE={"INVOICE": "VLM_GROUNDING"}
# Extractor serving the grounding branch. Empty means the native VLM extractor
# with grounding forced on, which is what lets one dossier mix a prebuilt OCR
# model with a vision deployment.
GROUNDING_EXTRACTOR_PROVIDER=

# ===========================================================================
# Preprocessing (Node 0)
# ===========================================================================
# Laplacian variance below BLUR_CRITICAL_THRESHOLD triggers an unsharp mask;
# below half of it the document is rejected before any API call.
BLUR_CRITICAL_THRESHOLD=120.0
BLUR_REFERENCE_WIDTH=1000
UNSHARP_AMOUNT=0.8
UNSHARP_SIGMA=2.0
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_GRID_SIZE=8
MAX_IMAGE_DIMENSION=2000
JPEG_QUALITY=85
ORIGINAL_JPEG_QUALITY=95
ROI_PADDING_RATIO=0.10
ROI_MIN_WIDTH=320
ROI_MAX_UPSCALE=4.0

# ===========================================================================
# Targeted ROI enhancement (dossier worker retry, Phase 6)
# ===========================================================================
# Applied to a cropped patch only, never to a whole page: bicubic rescaling,
# Fast Non-Local Means denoising, CLAHE, then unsharp masking.
ROI_UPSCALE_FACTOR=2.5
ROI_DENOISE_STRENGTH=7.0
ROI_DENOISE_COLOR_STRENGTH=7.0
ROI_CLAHE_CLIP_LIMIT=3.0
ROI_CLAHE_TILE_GRID_SIZE=8
ROI_ENHANCE_UNSHARP_AMOUNT=1.0
ROI_ENHANCE_UNSHARP_SIGMA=1.5

# ===========================================================================
# Azure AI Document Intelligence
# ===========================================================================
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# Leave the key EMPTY to authenticate secretlessly with Microsoft Entra ID:
# DefaultAzureCredential resolves a Managed Identity on a deployed host, a
# workload identity in AKS, or your `az login` session locally.
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Optional override of the document type to model mapping (JSON).
AZURE_MODEL_BY_DOC_TYPE={"ine": "prebuilt-idDocument", "invoice": "prebuilt-invoice"}
# Token audience requested for Entra ID authentication.
AZURE_CREDENTIAL_SCOPE=https://cognitiveservices.azure.com/.default

# ===========================================================================
# Microsoft AI Foundry (VLM_PROVIDER=azure_foundry)
# ===========================================================================
AZURE_FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o
# Page classification is the most frequent and least demanding call of a
# dossier run, so it gets a cheaper deployment.
AZURE_FOUNDRY_CLASSIFIER_DEPLOYMENT=gpt-4o-mini
AZURE_FOUNDRY_API_VERSION=2024-10-21
# Leave EMPTY to authenticate with Managed Identity, as above.
AZURE_FOUNDRY_API_KEY=

# ===========================================================================
# AWS Textract
# ===========================================================================
AWS_REGION=us-east-1
# Leave the keys empty to use the default boto3 credential chain (IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ===========================================================================
# Google Document AI
# ===========================================================================
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us
GOOGLE_PROCESSOR_BY_DOC_TYPE={"ine": "<identity-processor-id>", "invoice": "<invoice-processor-id>"}
GOOGLE_DEFAULT_PROCESSOR_ID=
GOOGLE_PROCESSOR_VERSION=
# Path to a service account JSON file; omit to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# ===========================================================================
# OpenAI
# ===========================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=

# ===========================================================================
# Anthropic
# ===========================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=

# ===========================================================================
# Ollama (local Qwen2.5-VL)
# ===========================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_KEEP_ALIVE=5m

# ===========================================================================
# Shared VLM tuning
# ===========================================================================
VLM_MAX_TOKENS=1024
VLM_TEMPERATURE=0.0
VLM_TIMEOUT_SECONDS=60.0

# ===========================================================================
# Native VLM extractor
# ===========================================================================
# Ask the VLM to also return normalized bounding boxes. Without geometry the
# ROI retry falls back to re-reading the whole page.
NATIVE_VLM_REQUEST_BOUNDING_BOXES=false
NATIVE_VLM_LAYOUT_HINTS={"ine": "The photo is on the left; CURP and the elector key are printed on the right block."}
